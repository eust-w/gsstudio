# syntax=docker/dockerfile:1
# GSStudio lightweight image - Python backend + static frontend only.
# No CUDA extensions compiled; runs with GSSTUDIO_MOCK_PIPELINE=true by default.
# Use Dockerfile.a800 for real GPU pipeline execution.

FROM python:3.11-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    GSSTUDIO_DATA_DIR=/data/tasks \
    GSSTUDIO_NUM_GPUS=5 \
    GSSTUDIO_PORT=8000 \
    GSSTUDIO_MOCK_PIPELINE=true

WORKDIR /app

# Install server dependencies
COPY server/ ./server/
COPY deploy/requirements-security.txt /tmp/requirements-security.txt
RUN pip install --no-cache-dir --index-url https://pypi.org/simple fastapi "uvicorn[standard]" python-multipart aiofiles websockets pydantic \
    && pip install --no-cache-dir --index-url https://pypi.org/simple --upgrade -r /tmp/requirements-security.txt \
    && rm /tmp/requirements-security.txt

# Copy pre-built frontend (build locally with: cd web && npm install && npm run build)
COPY web/dist/ ./web/dist/

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "server.main:app", "--host", "0.0.0.0", "--port", "8000"]

# Retain application and upstream license notices in distributed images.
COPY LICENSE NOTICE THIRD_PARTY_NOTICES.md /app/
COPY third_party/licenses/ /app/third_party/licenses/
