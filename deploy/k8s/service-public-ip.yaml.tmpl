# Template: render with deploy/scripts/render-public-service.sh (GSSTUDIO_PUBLIC_IP, GSSTUDIO_PUBLIC_PORT).
apiVersion: v1
kind: Service
metadata:
  name: gsstudio-public-ip
  namespace: gsstudio
  labels:
    app: gsstudio
  annotations:
    service.kubernetes.io/cce-update-in-time: "true"
    service.beta.kubernetes.io/cce.listener.customized-listener: |-
      {
        "${GSSTUDIO_PUBLIC_PORT}": {
          "protocol": "TCP",
          "scheduler": "RoundRobin",
          "timeout": "900"
        }
      }
    service.beta.kubernetes.io/cce.listener.customized-health-check: |-
      {
        "${GSSTUDIO_PUBLIC_PORT}": {
          "healthCheck": "TCP",
          "healthCheckTimeoutInSecond": "3",
          "healthCheckIntervalInSecond": "3",
          "healthCheckDownRetry": "3",
          "healthCheckUpRetry": "2"
        }
      }
spec:
  type: LoadBalancer
  loadBalancerIP: ${GSSTUDIO_PUBLIC_IP}
  externalTrafficPolicy: Local
  selector:
    app: gsstudio
  ports:
    - name: http
      port: ${GSSTUDIO_PUBLIC_PORT}
      targetPort: http
      protocol: TCP
