# syntax=docker/dockerfile:1
# GSStudio a800-v30: refresh WorldMirror data when a resumed quality manifest grows.
# Keeping CUDA extensions and model runtimes in the v22 base makes this release
# fast and avoids recompiling HY-World during a safety/quality-only rollout.
FROM ccr-29eug8s3-pub.cnc.bj.baidubce.com/dataflow-poc/gsstudio:a800-v22

USER root

# WorldNav depends on both the native SpatialIndex library and its Python
# binding.  Build-time and startup checks prevent the upstream silent fallback.
RUN apt-get update && apt-get install --yes --no-install-recommends \
        libspatialindex-dev \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir rtree \
    && python -c "import rtree; print('rtree preflight OK')"

# Reapply the idempotent offline-loading patch as a release invariant rather
# than assuming it was present in the inherited image.
COPY deploy/scripts/patch_hyworld_local_cache.py /tmp/patch_hyworld_local_cache.py
RUN python /tmp/patch_hyworld_local_cache.py \
        /opt/hyworld2/hyworld2/worldgen/models/worldstereo_wrapper.py \
    && rm /tmp/patch_hyworld_local_cache.py

# Patch the upstream GS-data entrypoint in place so it consumes only the
# accepted WorldStereo trajectory ids generated by GSStudio's quality gate.
COPY deploy/scripts/patch_hyworld_quality_filter.py /tmp/patch_hyworld_quality_filter.py
RUN python /tmp/patch_hyworld_quality_filter.py \
        /opt/hyworld2/hyworld2/worldgen/gen_gs_data.py \
    && rm /tmp/patch_hyworld_quality_filter.py

# Limit full-FSDP WorldStereo to the diverse candidates validated by NavMesh.
COPY deploy/scripts/patch_hyworld_video_filter.py /tmp/patch_hyworld_video_filter.py
RUN python /tmp/patch_hyworld_video_filter.py \
        /opt/hyworld2/hyworld2/worldgen/video_gen.py \
    && rm /tmp/patch_hyworld_video_filter.py

# Replace the public application surface and API/worker implementation.
COPY web/dist/ /app/web/dist/
COPY server/ /app/server/
COPY deploy/supervisord.conf /etc/supervisor/conf.d/gsstudio.conf
COPY deploy/scripts/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

WORKDIR /app
EXPOSE 8000 8100
ENTRYPOINT ["/app/entrypoint.sh"]
